modules = ["nodejs-20", "web", "python-3.11", "postgresql-16"]
run = "npm run dev"

[nix]
channel = "stable-25_05"
packages = ["imagemagick"]

[deployment]
run = ["npm", "run", "start"]
deploymentTarget = "vm"
build = ["npm", "run", "build"]

[[ports]]
localPort = 3000
externalPort = 3000

[[ports]]
localPort = 3001
externalPort = 3001

[[ports]]
localPort = 5000
externalPort = 80

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Run Dev Server"
author = 45718110
mode = "sequential"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run dev"

[[workflows.workflow]]
name = "Run Dev Server"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run dev -- -p 5000"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[agent]
expertMode = true
integrations = ["javascript_object_storage:2.0.0", "resend:1.0.0"]

