modules = ["nodejs-20", "web"]
run = "npm run dev"

[nix]
channel = "stable-25_05"
packages = ["imagemagick"]

[deployment]
run = ["sh", "-c", "npm run dev"]

[[ports]]
localPort = 3000

[[ports]]
localPort = 3001
externalPort = 3001

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 38887
externalPort = 3000

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Run Dev Server"
author = 45718110
mode = "sequential"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run dev"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Next.js Dev Server"

[[workflows.workflow]]
name = "Next.js Dev Server"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run dev -- -p 5000"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[agent]
expertMode = true
