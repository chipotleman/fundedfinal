modules = ["nodejs-20", "web", "postgresql-16"]
run = "npm run dev"

[nix]
channel = "stable-25_05"
packages = ["imagemagick"]

[deployment]
run = ["sh", "-c", "npm run dev"]

[[ports]]
localPort = 3000

[[ports]]
localPort = 3001
externalPort = 3001

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Run Dev Server"
author = 45718110
mode = "sequential"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run dev"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Next.js Dev Server"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "WebSocket Server"

[[workflows.workflow]]
name = "Next.js Dev Server"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run dev -- -p 5000"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow]]
name = "WebSocket Server"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "node ws-server.js"
waitForPort = 3001

[workflows.workflow.metadata]
outputType = "console"

[agent]
expertMode = true

[userenv]

[userenv.shared]
FANBASIS_CREATOR_ID = "802865"
NEXT_PUBLIC_FANBASIS_CREATOR_ID = "802865"
NEXT_PUBLIC_FANBASIS_PRODUCT_STARTER = "G5KXr"
NEXT_PUBLIC_FANBASIS_PRODUCT_PRO = "G5KXr"
NEXT_PUBLIC_FANBASIS_PRODUCT_ELITE = "G5KXr"
WS_SERVER_API_KEY = "3eb1ed8ffca2f6fd1a5b979753411fcf48ae7b1b9ead1120213ca21ac35698ef"
VERCEL_API_URL = "https://thepiks.com"
WS_PORT = "3001"
POLL_INTERVAL = "1000"
